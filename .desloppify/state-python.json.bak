    "review::.::holistic::cross_module_architecture::datasources_hub_coupling": {
      "id": "review::.::holistic::cross_module_architecture::datasources_hub_coupling",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "datasources.py is a hub module importing from 5 siblings, coupling infrastructure and business logic",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/analyzer/datasources.py"
        ],
        "evidence": [
          "datasources.py imports from analyzer.exceptions, analyzer.parsing, analyzer.models, analyzer.interfaces, and analyzer.database \u2014 the widest fan-in of any module",
          "Contains HouseTransactionSource (166 lines) and YFinancePriceSource (82 lines) that each instantiate Database directly, coupling data fetching to storage"
        ],
        "suggestion": "Extract database lifecycle management into a factory or inject Database instances into source constructors from the pipeline/cli layer. Consider splitting datasources.py into house_transactions.py and price_sources.py to reduce blast radius.",
        "reasoning": "",
        "summary_hash": "32a4c323"
      },
      "status": "open",
      "note": null,
      "first_seen": "2026-04-21T22:56:26+00:00",
      "last_seen": "2026-04-21T22:56:26+00:00",
      "resolved_at": null,
      "reopen_count": 0,
      "work_item_kind": "review_defect",
      "issue_kind": "review_defect",
      "origin": "review_import",
      "lang": "python",
      "suppressed": false,
      "suppressed_at": null,
      "suppression_pattern": null
    },
    "review::.::holistic::cross_module_architecture::import_time_cache_side_effect": {
      "id": "review::.::holistic::cross_module_architecture::import_time_cache_side_effect",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "requests_cache.install_cache() called at module scope in datasources.py, affecting all importers",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/analyzer/datasources.py"
        ],
        "evidence": [
          "Line 27: requests_cache.install_cache('http_cache', backend='sqlite', expire_after=3600) executes at import time",
          "cli.py imports HouseTransactionSource and YFinancePriceSource from datasources, triggering cache installation even when only type information is needed"
        ],
        "suggestion": "Move cache initialization into a function or classmethod (e.g., HouseTransactionSource._init_http_cache()) called once from the CLI entry point, or use a requests Session with cached transport passed to methods that need it.",
        "reasoning": "",
        "summary_hash": "763743b9"
      },
      "status": "open",
