      "id": "review::.::holistic::cross_module_architecture::enum_bypass_creates_implicit_contract",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Raw strings 'Purchase' and 'Sale' used instead of TransactionType enum across 3 modules",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/analyzer/analysis.py",
          "src/analyzer/datasources.py",
          "src/analyzer/pipeline.py",
          "src/analyzer/models.py"
        ],
        "evidence": [
          "analysis.py line 49: final['transaction_type'] == 'Purchase' instead of TransactionType.PURCHASE",
          "analysis.py lines 81-86: column_map uses raw 'Purchase' and 'Sale' strings",
          "datasources.py line 142: metadata['FilingType'] == 'P' instead of FilingType.PTR",
          "pipeline.py line 100: recent_trades['transaction_type'] == 'Purchase'"
        ],
        "suggestion": "Import and use TransactionType.PURCHASE and TransactionType.SALE in analysis.py and pipeline.py. Use FilingType.PTR in datasources.py. This makes the contract explicit and lets the type checker catch mismatches.",
