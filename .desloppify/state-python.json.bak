    "review::.::holistic::cross_module_architecture::direct_database_instantiation_in_sources": {
      "id": "review::.::holistic::cross_module_architecture::direct_database_instantiation_in_sources",
      "detector": "review",
      "file": ".",
      "tier": 1,
      "confidence": "high",
      "summary": "Data source classes construct Database internally, preventing injection and connection sharing",
      "detail": {
        "holistic": true,
        "dimension": "cross_module_architecture",
        "related_files": [
          "src/analyzer/datasources.py",
          "src/analyzer/database.py"
        ],
        "evidence": [
          "HouseTransactionSource.__init__ line 57: self.db = Database(self.data_dir / 'congress.duckdb')",
          "YFinancePriceSource.__init__ line 222: self.db = Database(self.data_dir / 'congress.duckdb')",
          "Two separate Database instances for the same file can exist simultaneously"
        ],
        "suggestion": "Accept a Database instance via constructor parameter (with a factory default) so the pipeline/cli layer can control the database lifecycle and share a single connection.",
